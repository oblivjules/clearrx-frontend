<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.CleaRx" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
    </style>

    <style name="Theme.CleaRx" parent="Base.Theme.CleaRx" />

    <style name="Theme.CleaRx.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/clearx_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CleaRx</item>
    </style>

    <!-- Original thumbnail rounded corners -->
    <style name="RoundedSquare" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Pill-shaped primary button (red) -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Pill-shaped outlined button (red border) -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.App.Button.Header" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/surface_card</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="ThemeOverlay.CleaRx.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Outlined</item>
    </style>
</resources>
