<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/accentBar"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:background="@color/brand_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/accentBar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/itemDrugName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="normal" />

            <TextView
                    android:id="@+id/itemConfidenceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:visibility="gone" />

            <TextView
                android:id="@+id/itemMealRelation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/chip_bg_red"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="—"
                android:textColor="@color/chip_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#F0F0F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/itemStrengthCell"
                    style="@style/MedicineCell"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/itemStrengthLabel"
                        style="@style/MedicineLabel"
                        android:text="STRENGTH" />
                    <TextView
                        android:id="@+id/itemStrength"
                        style="@style/MedicineValue" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/itemDosageFormCell"
                    style="@style/MedicineCell">
                    <TextView
                        style="@style/MedicineLabel"
                        android:text="FORM" />
                    <TextView
                        android:id="@+id/itemDosageForm"
                        style="@style/MedicineValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/itemDoseAmountCell"
                    style="@style/MedicineCell"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/MedicineLabel" android:text="DOSE" />
                    <TextView android:id="@+id/itemDoseAmount" style="@style/MedicineValue" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/itemFrequencyCell"
                    style="@style/MedicineCell">
                    <TextView style="@style/MedicineLabel" android:text="FREQUENCY" />
                    <TextView android:id="@+id/itemFrequency" style="@style/MedicineValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/itemTimingCell"
                    style="@style/MedicineCell"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/MedicineLabel" android:text="TIMING" />
                    <TextView android:id="@+id/itemTiming" style="@style/MedicineValue" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/itemRouteCell"
                    style="@style/MedicineCell">
                    <TextView style="@style/MedicineLabel" android:text="ROUTE" />
                    <TextView android:id="@+id/itemRoute" style="@style/MedicineValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/itemQuantityCell"
                    style="@style/MedicineCell"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/MedicineLabel" android:text="QTY" />
                    <TextView android:id="@+id/itemQuantity" style="@style/MedicineValue" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/itemDurationCell"
                    style="@style/MedicineCell">
                    <TextView style="@style/MedicineLabel" android:text="DURATION" />
                    <TextView android:id="@+id/itemDuration" style="@style/MedicineValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemInstructionsCell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">
                <TextView style="@style/MedicineLabel" android:text="INSTRUCTIONS" />
                <TextView android:id="@+id/itemInstructions" style="@style/MedicineValue" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
